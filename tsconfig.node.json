{
  "compilerOptions": {
    "target": "ES2022",
    // DOM entra aquí porque los tests de Playwright ejecutan código de
    // navegador dentro de page.evaluate(): sin estos tipos, `document` y
    // `HTMLElement` no existen para el compilador.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Y esto porque algún test importa un módulo de la aplicación para no
    // repetir a mano lo que ya está declarado allí —los orígenes de FUENTES,
    // por ejemplo—, y esos módulos son `.tsx`. Sin `jsx`, el compilador se
    // niega a abrirlos aunque el test no escriba una sola etiqueta.
    "jsx": "react-jsx",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  // `api` entra aquí y no en la aplicación: es código de servidor, con tipos de
  // Node y sin nada del navegador. Que lo revise el compilador importa más de lo
  // normal, porque es lo único que no se puede probar abriendo la pantalla.
  "include": ["vite.config.ts", "playwright.config.ts", "e2e", "api"]
}
